# API
PORT=3001
SESSION_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:5173
ROOM_TTL_HOURS=6
HOST_RECONNECT_GRACE_SECONDS=60
# Google Cloud Console > YouTube Data API v3 > Credentials > API key
YOUTUBE_API_KEY=

# Web (copy to apps/web/.env.local only when deploying frontend separately)
VITE_API_URL=http://localhost:3001
# Optional TURN relay for networks where direct WebRTC cannot connect
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
